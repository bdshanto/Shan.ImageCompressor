<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Shan.ImageCompressor</PackageId>
    <Version>2.0.0</Version>
    <Authors>Hasibul Islam Shanto</Authors>
    <Description>Compress JPEG, PNG, GIF (animated too), WebP, BMP, TIFF, TGA, PNM and QOI images toward a target file size with zero dependencies (own codecs, including progressive and CMYK JPEG, lossy and lossless WebP): resize to a box, crop, rotate, mirror, ICC-to-sRGB colour conversion, optional EXIF/ICC preservation, EXIF auto-orient, and alpha-aware JPEG/PNG output.</Description>
    <PackageTags>image;compression;jpeg;png;gif;animated-gif;webp;bmp;tiff;tga;qoi;icc;resize;crop;rotate;exif;no-dependencies</PackageTags>
    <Copyright>Copyright (c) 2026 Hasibul Islam Shanto</Copyright>
    <RepositoryUrl>https://github.com/bdshanto/Shan.ImageCompressor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bdshanto/Shan.ImageCompressor</PackageProjectUrl>
    <PackageReleaseNotes>Adds animated GIF compression, WebP input (lossy and lossless, with alpha), MaxWidth/MaxHeight, crop, rotate, mirror and resize filters, and faster JPEG decoding. Full notes: https://github.com/bdshanto/Shan.ImageCompressor/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shan.ImageCompressor.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
