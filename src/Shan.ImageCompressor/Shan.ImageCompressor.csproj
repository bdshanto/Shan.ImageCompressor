<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Shan.ImageCompressor</PackageId>
    <Version>2.0.0</Version>
    <Authors>Hasibul Islam Shanto</Authors>
    <Description>Compress JPEG, PNG, GIF, BMP, TIFF, TGA, PNM and QOI images toward a target file size with zero dependencies (own codecs, including progressive and CMYK JPEG): ICC-to-sRGB colour conversion, optional EXIF/ICC preservation, EXIF auto-orient, and alpha-aware JPEG/PNG output.</Description>
    <PackageTags>image;compression;jpeg;png;gif;bmp;tiff;tga;qoi;icc;resize;exif;no-dependencies</PackageTags>
    <Copyright>Copyright (c) 2026 Hasibul Islam Shanto</Copyright>
    <RepositoryUrl>https://github.com/bdshanto/Shan.ImageCompressor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bdshanto/Shan.ImageCompressor</PackageProjectUrl>
    <PackageReleaseNotes>BREAKING: errors are now InvalidImageException / UnsupportedImageException (base ImageCompressionException). Adds TIFF, TGA, PNM, QOI and CMYK JPEG input, an Output option, KeepMetadata, and ICC-to-sRGB colour conversion. Full notes: https://github.com/bdshanto/Shan.ImageCompressor/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shan.ImageCompressor.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
