<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Shan.ImageCompressor</PackageId>
    <Version>1.0.1</Version>
    <Authors>Hasibul Islam Shanto</Authors>
    <Description>Compress JPEG and PNG images toward a target file size with zero dependencies (own PNG and JPEG codecs): format sniffing from the bytes, EXIF auto-orient, metadata stripping, and alpha-aware JPEG/PNG output.</Description>
    <PackageTags>image;compression;jpeg;png;resize;exif;no-dependencies</PackageTags>
    <Copyright>Copyright (c) 2026 Hasibul Islam Shanto</Copyright>
    <RepositoryUrl>https://github.com/bdshanto/Shan.ImageCompressor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/bdshanto/Shan.ImageCompressor</PackageProjectUrl>
    <PackageReleaseNotes>Package metadata only, no code changes: adds release notes, repository URL, project URL and copyright, and publishes through nuget.org Trusted Publishing. Full notes: https://github.com/bdshanto/Shan.ImageCompressor/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shan.ImageCompressor.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
